{
    "openapi": "3.0.0",
    "info": {
        "title": "Begento Healthcare Solutions - Backend Laravel API",
        "description": "API RESTful para la gestión de productos, costos y precios en diferentes divisas.",
        "contact": {
            "name": "Soporte Técnico",
